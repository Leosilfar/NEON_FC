{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:desktop": "vite build --base=./ && electron-builder --win nsis && electron-builder --win portable",
    "desktop:run": "vite build --base=./ && electron .",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "howler": "^2.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "main": "electron/main.cjs",
  "description": "NEON FC desktop football game",
  "author": "Leosilfar",
  "build": {
    "appId": "com.leosilfar.neonfc",
    "productName": "NEON FC",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
